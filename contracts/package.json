{
  "name": "hardproblems-contracts",
  "version": "1.0.0",
  "description": "HPW ERC-20 token + deployment scripts for HardProblems.World",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test contracts/test/HPW.test.cjs",
    "deploy:baseSepolia": "hardhat run contracts/scripts/deploy.cjs --network baseSepolia",
    "deploy:base": "hardhat run contracts/scripts/deploy.cjs --network base"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0"
  }
}

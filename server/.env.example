# HardProblems.World 后端配置
# 复制为 .env 并按需修改

# === 服务 ===
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# === 安全 ===
# 生产环境必须改成强随机串（32 字节以上）
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32

# === 跨域 ===
# 多个用逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://hardproblems.world

# === 限流 ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# === 区块链 ===
BLOCK_INTERVAL_MS=5000
GENESIS_NONCE=0

# === AI ===
# LLM 模型（minimax/MiniMax-M2.7-highspeed, openai/gpt-4, anthropic/claude-sonnet-4-6 等）
LLM_MODEL=minimax/MiniMax-M2.7-highspeed
LLM_TIMEOUT_MS=90000
# 是否启用 LLM（关闭后用本地启发式评估）
LLM_ENABLED=true

# === 存储 ===
DATA_DIR=./data

# === 日志 ===
LOG_LEVEL=info
